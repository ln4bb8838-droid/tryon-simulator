{
  "name": "tryon-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "アパレル事業者向け試着シミュレータ（MVP: AIモデルの試着室）",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next dev",
    "build": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next build",
    "start": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
